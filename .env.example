# ─── Banco de Dados ────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/romatec_crm

# ─── Autenticação ──────────────────────────────────────────────────────────
JWT_SECRET=sua_chave_secreta_aqui

# ─── Z-API (WhatsApp) ──────────────────────────────────────────────────────
# Obtido em app.z-api.io → sua instância
ZAPI_INSTANCE_ID=SUA_INSTANCE_ID
ZAPI_TOKEN=SEU_TOKEN
ZAPI_CLIENT_TOKEN=SEU_CLIENT_TOKEN   # opcional (segurança extra)

# ─── Meta (Instagram / Facebook Lead Ads) ──────────────────────────────────
# Webhook: https://romateccrm.com/api/webhook/meta (campo leadgen da Página)
META_APP_SECRET=                # valida a assinatura X-Hub-Signature-256
META_VERIFY_TOKEN=              # string sua, usada na verificação do webhook
META_PAGE_ACCESS_TOKEN=         # token de longa duração da Página (leads_retrieval)
META_IG_ACCOUNT_ID=             # conta profissional do Instagram (Direct, fase futura)
META_GRAPH_VERSION=v26.0        # opcional

# ─── Fan-out pra ZAYRA (RomatecVoiceAgent) ─────────────────────────────────
# Quando configurado, mensagens DO CEO no WhatsApp são repassadas pra ZAYRA
# (e o bot do CRM NÃO responde no caso do CEO, pra evitar dupla resposta).
# Outros leads continuam respondidos normalmente pelo bot do CRM.
# Filtro: só dispara quando from.phone == CEO_WHATSAPP_PHONE.
CEO_WHATSAPP_PHONE=             # ex: 5599991811246
ZAYRA_WEBHOOK_URL=              # ex: https://romatecvoiceagent-production.up.railway.app/webhook/whatsapp

# ─── Web Push (notificações com o app fechado, v1.8.0) ─────────────────────
# Gerar UMA vez: npx web-push generate-vapid-keys  → copiar as duas chaves para o Railway.
# Sem as duas, o sininho funciona normalmente e só o push com o app fechado fica desligado.
# Trocar as chaves invalida as inscrições: cada pessoa precisa "Ativar neste aparelho" de novo.
VAPID_PUBLIC_KEY=               # "Public Key" (vai para o navegador)
VAPID_PRIVATE_KEY=              # "Private Key" (só no servidor — nunca no código nem no chat)
VAPID_SUBJECT=                  # opcional; padrão https://romateccrm.com

# ─── Contratos e cobrança (v1.9.0) ─────────────────────────────────────────
# Sem ASAAS_API_KEY_BOMJARDIMS o módulo de cobrança fica DORMENTE: nada é emitido nem cobrado.
ASAAS_API_KEY_BOMJARDIMS=       # chave da conta Asaas do Bom Jardims (só no Railway); na falta, vale ASAAS_API_KEY (a mesma do ZAYRA)
ASAAS_AMBIENTE=                 # opcional: producao | sandbox (padrão: deduzido do prefixo da chave $aact_prod_ / $aact_hmlg_)
# Webhook no painel do Asaas: https://romateccrm.com/api/webhook/asaas  (token no header asaas-access-token ou ?token=)
FINANCEIRO_LINK_SECRET=         # opcional; assina os links de boleto/carnê do comprador (padrão: JWT_SECRET)
ASAAS_WEBHOOK_TOKEN=            # token que o Asaas envia no header asaas-access-token do webhook
ASAAS_WALLET_COMISSAO=          # walletId da Romatec para o split da comissão
ASAAS_BASE_URL=                 # opcional; padrão https://api.asaas.com/v3 (sandbox: https://api-sandbox.asaas.com/v3)
CONTRATOS_STORAGE=db            # PDFs e versões ficam no banco (tabela contratoArquivos) — o disco do Railway some a cada deploy
APP_PUBLIC_URL=                 # opcional; padrão https://romateccrm.com (links de assinatura e verificação)
SOFFICE_BIN=                    # opcional; padrão "soffice" (LibreOffice instalado no Dockerfile)

# ─── Telegram (Notificações) ───────────────────────────────────────────────
# Pode ser configurado também pela tela de Configurações no sistema
TELEGRAM_BOT_TOKEN=110201543:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
TELEGRAM_CHAT_ID=-1001234567890

# ─── OpenAI (Bot IA) ───────────────────────────────────────────────────────
# Pode ser configurado também pela tela de Configurações no sistema
OPENAI_API_KEY=sk-...

# ─── Cloudinary (Upload de imagens) ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=seu_cloud
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# ─── Servidor ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Captação de leads v1 (server/leads) ───────────────────────────────────
ASSISTENTE_NOME=Assistente Romatec   # nome do assistente nas mensagens automáticas
NOTIFY_CANAIS=telegram               # telegram | whatsapp | telegram,whatsapp (WhatsApp falhou → cai no Telegram)
NOTIFY_PHONES=+5599991811246         # WhatsApp do José para os avisos (quando NOTIFY_CANAIS tiver whatsapp)
ZAPI_NUMERO_E164=+5599991811246      # número que recebe os leads (destino dos links wa.me)
APP_URL=https://romateccrm.com
AVALIEIMOB_URL=                      # ex.: https://app.avalieimob.com.br (botões PTAM e exclusividade no lead proprietário)
ANTHROPIC_API_KEY=                   # Claude: qualificação por IA (sem ela, usa OPENAI_API_KEY)
ANTHROPIC_MODEL=claude-sonnet-5-5    # modelo da qualificação
QUALIFICACAO_IA=on                   # off = só o roteiro de perguntas (bot antigo)
